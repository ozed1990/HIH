{%- comment -%}
  HIH head: self-hosted fonts, tokens, styles, and the cross-page transition hooks.
  Rendered from layout/theme.liquid right after base.css so HIH tokens win over Dawn defaults.
{%- endcomment -%}
{{ 'hih-instrument-serif-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
{{ 'hih-manrope-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
<style>
  @font-face { font-family: "Instrument Serif"; src: url("{{ 'hih-instrument-serif-400.woff2' | asset_url }}") format("woff2"); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: "Manrope"; src: url("{{ 'hih-manrope-var.woff2' | asset_url }}") format("woff2"); font-weight: 200 800; font-style: normal; font-display: swap; }
</style>
{%- if settings.favicon == blank -%}
  <link rel="icon" type="image/png" href="{{ 'hih-favicon.png' | asset_url }}">
  <link rel="apple-touch-icon" href="{{ 'hih-favicon.png' | asset_url }}">
{%- endif -%}
{%- render 'hih-schema' -%}
{{ 'hih-tokens.css' | asset_url | stylesheet_tag }}
{{ 'hih.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hih.js' | asset_url }}" defer="defer"></script>
<script>
  /* Cross-page transitions. Must run before first render, so it is inline and not deferred.
     1. Shared elements: an element with data-vt-href (the link target) + data-vt-name on the old page
        morphs into the element with the same name in data-vt-to on the new page
        (guide card photo -> guide hero, category tile title -> category page title).
     2. Filter reflow: moving between tag filters of one category, every card present on both pages
        slides to its new spot (cards carry data-guide-card; the grid carries data-vt-group = blog url). */
  (function () {
    function isFilterOf(base, path) { return path === base || path.indexOf(base + '/tagged/') === 0; }
    function nameCards(on) {
      document.querySelectorAll('[data-vt-group] [data-guide-card]').forEach(function (c) {
        c.style.viewTransitionName = on ? 'hih-card-' + c.getAttribute('data-guide-card') : '';
      });
    }
    window.addEventListener('pageswap', function (e) {
      if (!e.viewTransition || !e.activation || !e.activation.entry) return;
      var path = new URL(e.activation.entry.url).pathname;
      var group = document.querySelector('[data-vt-group]');
      if (group && isFilterOf(group.getAttribute('data-vt-group'), path)) { nameCards(true); return; }
      var el = document.querySelector('[data-vt-href="' + path + '"][data-vt-name]');
      if (el) el.style.viewTransitionName = el.getAttribute('data-vt-name');
    });
    window.addEventListener('pagereveal', function (e) {
      if (!e.viewTransition) return;
      var from = window.navigation && navigation.activation && navigation.activation.from;
      var fromPath = from && from.url ? new URL(from.url).pathname : '';
      var group = document.querySelector('[data-vt-group]');
      var named = [];
      if (group && fromPath && isFilterOf(group.getAttribute('data-vt-group'), fromPath)) {
        nameCards(true);
      } else {
        document.querySelectorAll('[data-vt-to]').forEach(function (t) {
          t.style.viewTransitionName = t.getAttribute('data-vt-to'); named.push(t);
        });
      }
      e.viewTransition.finished.then(function () {
        nameCards(false);
        named.forEach(function (t) { t.style.viewTransitionName = ''; });
      });
    });
  })();
</script>
