<section class="hih-section{% if section.settings.mist %} hih-section--mist{% endif %}">
  <div class="hih-container">
    <div class="hih-section__head">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.link != blank -%}<a class="hih-link-quiet" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
    </div>
    <div class="hih-cards">
      {%- for block in section.blocks -%}
        {%- if block.settings.article != blank -%}
          <div {{ block.shopify_attributes }}>{% render 'hih-guide-card', article: block.settings.article, label: block.settings.label %}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HIH featured guides",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Guides to start with" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All guides" },
    { "type": "checkbox", "id": "mist", "label": "Tinted background", "default": false }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Guide",
      "settings": [
        { "type": "article", "id": "article", "label": "Guide" },
        { "type": "text", "id": "label", "label": "Category label" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "HIH featured guides" }]
}
{% endschema %}
