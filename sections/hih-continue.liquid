{%- comment -%}
  "Pick up where you left off": guides this visitor opened recently, newest first, with their step progress.
  Filled by hih.js from this browser's own history (localStorage key hih:recent); stays hidden for first-time visitors.
{%- endcomment -%}
<section class="hih-section hih-continue" data-hih-continue hidden>
  <div class="hih-container">
    <div class="hih-section__head">
      <div>
        <h2>{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.text | escape }}</p>
      </div>
    </div>
    <div class="hih-cards" data-hih-spot data-hih-continue-grid></div>
  </div>
</section>

{% schema %}
{
  "name": "HIH continue reading",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick up where you left off" },
    { "type": "text", "id": "text", "label": "Text", "default": "Guides you opened recently, with your progress saved on this device." }
  ],
  "presets": [{ "name": "HIH continue reading" }]
}
{% endschema %}
