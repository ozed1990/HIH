{%- comment -%}
  Guide card. Renders the Guide contract fields (hih-guide-writer): image, title, guide.difficulty, guide.time_required.
  Params: article (required), label (optional small line above the title, e.g. the category name), heading_tag (default h3)
{%- endcomment -%}
{%- liquid
  assign g = article.metafields.guide
  assign tag = heading_tag | default: 'h3'
-%}
<a class="hih-card" href="{{ article.url }}" data-guide-card="{{ article.id }}">
  <span class="hih-media" data-vt-href="{{ article.url }}" data-vt-name="hih-guide-hero">
    {%- if article.image -%}
      {{- article.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 62em) 30vw, (min-width: 40em) 45vw, 92vw', loading: 'lazy', class: 'hih-fade', alt: '' -}}
    {%- endif -%}
  </span>
  {%- if label != blank -%}<span class="hih-card__blog">{{ label | escape }}</span>{%- endif -%}
  <{{ tag }} class="hih-card__title"><span class="hih-underline">{{ article.title | escape }}</span></{{ tag }}>
  {%- if g.difficulty != blank or g.time_required != blank -%}
    <ul class="hih-meta">
      {%- if g.difficulty != blank -%}<li>{{ g.difficulty.value | escape }}</li>{%- endif -%}
      {%- if g.time_required != blank -%}<li>{{ g.time_required.value | escape }}</li>{%- endif -%}
    </ul>
  {%- endif -%}
</a>
